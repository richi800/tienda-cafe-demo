# Plantilla de variables de entorno. Copia este archivo como .env.local y completa los valores.
# .env.local está ignorado por git: nunca subas tokens reales al repositorio.
# En Vercel, configura estas mismas variables en Project Settings > Environment Variables.

# Dominio de la tienda de desarrollo de Shopify, sin https://. Ejemplo: mi-tienda.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Token de acceso de la Storefront API (app "Headless" o app personalizada en el admin de Shopify).
# Solo se usa en el servidor; no lleva el prefijo NEXT_PUBLIC_ para que no llegue al navegador.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Versión de la Storefront API con formato AAAA-MM. Ejemplo: 2025-10
SHOPIFY_STOREFRONT_API_VERSION=
